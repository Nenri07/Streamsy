{
  "name": "backendproject",
  "version": "1.0.0",
  "description": "backend with chai aurcode",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon -r dotenv/config --experimental-json-modules src/index.js",
    "start": "node src/index.js",
    "worker": "node src/workers/hlsWorker.js",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down -v",
    "docker:clean": "docker compose down -v && docker system prune -f"
  },
  "keywords": [
    "javascript",
    "backend",
    "chai",
    "aur",
    "code"
  ],
  "author": "Umer",
  "license": "ISC",
  "devDependencies": {
    "nodemon": "^3.1.9",
    "prettier": "^3.5.3"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.922.0",
    "@aws-sdk/s3-request-presigner": "^3.922.0",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.63.0",
    "cloudinary": "^2.6.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "fluent-ffmpeg": "^2.1.3",
    "ioredis": "^5.8.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.12.1",
    "mongoose-aggregate-paginate-v2": "^1.1.4",
    "multer": "^1.4.5-lts.1",
    "streamifier": "^0.1.1"
  }
}
